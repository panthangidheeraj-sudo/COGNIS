# COGNIS / Signalpost backend configuration.
# Copy to .env and fill in what you have. Every key is optional: without keys the
# system still runs on the official registers and registry-linked websites.
# NEVER commit .env — it is git-ignored.

# --- mode -------------------------------------------------------------------
APP_ENV=development
# development | competition (competition hides /docs and debug endpoints)
RUN_MODE=development

# --- LLM (the "brain"; optional) --------------------------------------------
# none | groq | openai_compatible | fake (deterministic, for tests)
LLM_PROVIDER=none
GROQ_API_KEY=
# REQUIRED when GROQ_API_KEY is set. Use a model your account may use (list: https://console.groq.com/docs/models).
# Good choices: llama-3.3-70b-versatile (recommended default) | openai/gpt-oss-120b | llama-3.1-8b-instant (fastest, weakest)
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Any OpenAI-compatible endpoint (only when LLM_PROVIDER=openai_compatible)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Space LLM calls (seconds) if your plan has a low requests-per-minute limit, e.g. 2.0 for 30/min
LLM_MIN_INTERVAL_SECONDS=0
# Reasoning models (openai/gpt-oss-*, qwen/qwen3*) think before answering. Leave empty for the default
# (gpt-oss: low, qwen3: none); or set low | medium | high | none.
LLM_REASONING_EFFORT=

# --- web discovery (optional) -----------------------------------------------
# Tavily Search API (free plan: 1,000 credits/month, no card needed; a basic search = 1 credit).
# Candidates only, never evidence. Get a key at https://app.tavily.com (it starts with tvly-).
# Without it, discovery uses the register's website field and the registered e-mail domain.
TAVILY_API_KEY=

# --- licensed / reviewed sources (disabled unless you hold access) ----------
ENABLE_PROFF=false
PROFF_API_KEY=
ENABLE_DOFFIN=false
DOFFIN_API_KEY=
ENABLE_PATENTSTYRET=false
PATENTSTYRET_API_KEY=

# --- politeness / identity ---------------------------------------------------
CONTACT_EMAIL=submit@builderr.ai
RESPECT_ROBOTS=true

# --- run budgets (hard limits for a batch run) ------------------------------
MAX_RUN_SECONDS=2700
MAX_REQUESTS=2000
MAX_EXTERNAL_COST_USD=10
BUDGET_HEADROOM=0.9
FINALIZE_RESERVE_SECONDS=45
MAX_CONCURRENCY=8

# --- per-company limits -------------------------------------------------------
PER_COMPANY_MAX_SECONDS=120
PER_COMPANY_MAX_REQUESTS=30
MAX_SEARCHES_PER_COMPANY=3
MAX_PAGES_PER_SITE=8
MAX_LLM_CALLS_PER_COMPANY=4
MAX_RESEARCH_ROUNDS=3

# --- storage ------------------------------------------------------------------
# SQLite lives in backend/data by default. If the project sits in a synced folder (OneDrive,
# Dropbox), point this at a local, non-synced folder to avoid file-locking problems, e.g.
# DATA_DIR=C:\Users\you\AppData\Local\cognis
# DATA_DIR=

# --- API ----------------------------------------------------------------------
# Comma-separated origins allowed to call the API directly (the Vite dev proxy needs none).
CORS_ORIGINS=http://localhost:5173
