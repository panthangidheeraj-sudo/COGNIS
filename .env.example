# COGNIS frontend configuration (never put secrets here — everything VITE_* ships to the browser)
# mock = built-in demo backend with fixture data; live = call the real COGNIS backend
VITE_API_MODE=mock
# Base URL of the COGNIS backend when VITE_API_MODE=live (the dev server also proxies /api -> localhost:8000)
VITE_API_BASE_URL=/api
